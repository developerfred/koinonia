---
import Default from '@astrojs/starlight/components/Head.astro';
import { ORIGIN, SITE, REPO, twinPath } from '../lib/site';

const { entry, id } = Astro.locals.starlightRoute;
const url = `${SITE}${import.meta.env.BASE_URL.replace(/\/$/, '')}/${id}/`;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      headline: entry.data.title,
      description: entry.data.description,
      url,
      inLanguage: 'en',
      isPartOf: { '@type': 'WebSite', name: 'Koinonia', url: `${ORIGIN}/` },
      about: { '@type': 'SoftwareApplication', name: 'Koinonia', url: `${ORIGIN}/` },
      encoding: { '@type': 'MediaObject', contentUrl: `${SITE}${twinPath(id)}`, encodingFormat: 'text/markdown' },
      license: `${REPO}/blob/main/LICENSE`,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Koinonia', item: `${ORIGIN}/` },
        { '@type': 'ListItem', position: 2, name: 'Docs', item: `${ORIGIN}/docs/` },
        ...(id !== 'docs' ? [{ '@type': 'ListItem', position: 3, name: entry.data.title, item: url }] : []),
      ],
    },
  ],
};
---
<Default><slot /></Default>
<link rel="alternate" type="text/markdown" href={`${SITE}${twinPath(id)}`} />
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<script>
  import '../scripts/docs-tools.ts';
</script>
