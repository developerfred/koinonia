{
  "name": "@koinonia/agents",
  "version": "0.1.0",
  "description": "Multi-agent runtime that operates a Koinonia live stream through WebMCP tools.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": { "koinonia-agents": "bin/koinonia-agents.mjs" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.mjs",
    "cli": "node bin/koinonia-agents.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.21.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
