{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "skipLibCheck": true,
    "noEmit": true, "allowImportingTsExtensions": true, "allowJs": true, "lib": ["ES2022", "DOM"], "types": ["node"],
    "noUncheckedIndexedAccess": false
  },
  "include": ["lib", "contract", "integration", "security", "fuzz", "properties", "evals", "e2e", "soak", "*.ts"]
}
