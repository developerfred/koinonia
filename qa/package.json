{
  "name": "koinonia-qa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cross-component QA harness for Koinonia (contract, integration, e2e, fuzz, security, evals, soak).",
  "scripts": {
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "lint": "eslint ..",
    "typecheck": "tsc --noEmit",
    "fixtures": "node tools/gen-fixtures.mjs",
    "fixtures:check": "node tools/gen-fixtures.mjs --check",
    "evals:update": "UPDATE_BASELINE=1 vitest run evals",
    "soak": "tsx soak/soak.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "5.0.5",
    "ws": "^8.18.0"
  }
}
